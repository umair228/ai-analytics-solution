# Copy this to .env.prod and fill in real values before running docker compose up.
# Keep .env.prod OUT of version control.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string     # openssl rand -hex 50
DJANGO_ALLOWED_HOSTS=localhost,dis.yourlab.local
DJANGO_SSL_REDIRECT=True
CORS_ALLOWED_ORIGINS=https://dis.yourlab.local

# Encryption key for stored DataSource credentials (generate ONCE; rotating it
# invalidates saved connection passwords):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DSE_FERNET_KEY=

# ── App metadata DB (Postgres + pgvector — must match the db service) ─────────
PG_DB_NAME=dse
PG_DB_USER=dse
PG_DB_PASSWORD=change-me
PG_DB_HOST=db
PG_DB_PORT=5432

# ── LLM serving (production = vLLM; OpenAI-compatible) ────────────────────────
LLM_PROVIDER=local
LLM_BASE_URL=http://vllm:8000/v1                        # the vllm compose service
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=16384
LLM_TIMEOUT=300
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=24

# ── Retrieval (enterprise scale → pgvector) ──────────────────────────────────
DOCSEARCH_VECTOR_BACKEND=pgvector
DOCSEARCH_PGVECTOR_DSN=postgresql://dse:change-me@db:5432/dse
DOCSEARCH_EMBED_MODEL=BAAI/bge-base-en-v1.5
DOCSEARCH_RERANK_MODEL=BAAI/bge-reranker-base
# On a CPU-only box, keep the cross-encoder reranker OFF: it's a ~1GB model that
# the FIRST query would otherwise download + load synchronously inside the
# gunicorn worker, blowing the request timeout and killing the worker (client
# sees a 502). BM25 + the bge embedder + the LLM already answer well without it.
DOCSEARCH_ENABLE_RERANK=False
# Persist the downloaded HF model weights on the media volume so they survive
# container restarts/redeploys instead of re-downloading each boot.
HF_HOME=/app/media/hf-cache
# After a deploy, warm the embedder ONCE outside the request path:
#   docker compose exec api python manage.py warm_docsearch
# Torch on a CPU-only host: pin threads to avoid worker crashes under load.
OMP_NUM_THREADS=1

# ── Lab LIMS source (READ-ONLY) — per tenant; example = EGPC ─────────────────
DB_ENGINE=mssql
DB_NAME=EGPC_DEV
DB_HOST=lims-host
DB_PORT=1433
DB_USER=dis_readonly                                    # dedicated READ-ONLY db user
DB_PASSWORD=change-me
DB_DRIVER=ODBC Driver 18 for SQL Server

# ── LIMS Forecasting source (REQUIRED when DB_ENGINE=mssql) ──────────────────
# Forecasting (sample volume / instrument downtime / inventory) runs on the
# committed, self-contained oil-&-gas warehouse (forecasting/warehouse/, baked
# into the image) + its committed models. This override keeps forecasting on
# that sqlite warehouse while the rest of the app reads the live MSSQL LIMS
# above — WITHOUT it, FORECAST_DB inherits DB_ENGINE=mssql and forecasting
# queries the live LIMS (wrong tables/instruments → broken forecasts).
FORECAST_DB_ENGINE=sqlite
# Path defaults to the committed warehouse; override only if you relocate it:
# FORECAST_DB_SQLITE_PATH=/app/forecasting/warehouse/refinery_lims.sqlite3

# ── Query safety limits ──────────────────────────────────────────────────────
DSE_QUERY_MAX_ROWS=5000
DSE_QUERY_TIMEOUT_SECONDS=30

# ── SSO (OIDC) — see config/settings/sso.py; pip install mozilla-django-oidc ──
OIDC_ENABLED=False
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_BASE_URL=                                       # e.g. https://login.yourorg.com/realms/lab
OIDC_RP_SIGN_ALGO=RS256

# ── Email notifications (optional) ───────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=dis-alerts@yourlab.local

# ── Optional: HF token for the first vLLM model pull ─────────────────────────
HF_TOKEN=
