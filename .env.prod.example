# Copy this to .env.prod and fill in real values before running docker-compose up.

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,your-server-hostname-or-ip
DJANGO_SSL_REDIRECT=False

# PostgreSQL (must match the db service credentials)
PG_DB_NAME=dse
PG_DB_USER=dse
PG_DB_PASSWORD=dse
PG_DB_HOST=db
PG_DB_PORT=5432

# Encryption key for stored credentials (generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DSE_FERNET_KEY=

# CORS — set to the URL the browser reaches the frontend on
CORS_ALLOWED_ORIGINS=http://localhost

# Claude API (optional — needed for AI assistant features)
CLAUDE_API_KEY=

# Email notifications (optional — leave blank to disable email alerts)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=dse-alerts@example.com

# Query safety limits
DSE_QUERY_MAX_ROWS=5000
DSE_QUERY_TIMEOUT_SECONDS=30
