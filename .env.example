# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-secret-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- CORS (frontend origin) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Credential encryption ----
# Leave blank in dev (derived from SECRET_KEY). In prod set a real Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DSE_FERNET_KEY=

# ---- App metadata DB (prod only — Postgres; dev uses SQLite) ----
PG_DB_NAME=dse
PG_DB_USER=dse
PG_DB_PASSWORD=
PG_DB_HOST=127.0.0.1
PG_DB_PORT=5432

# ---- JWT ----
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Set to cap sessions in hours instead (overrides JWT_REFRESH_DAYS):
# JWT_REFRESH_HOURS=12

# ---- Reporting: branding, exports, scheduled reports ----
# Branding is served as-is by GET /api/branding/ (blank = the SPA's own names);
# exported files and emails fall back to "Data Science Engine" when blank.
# DIS_BRAND_PRODUCT_NAME=
# DIS_BRAND_SHORT_NAME=
# DIS_BRAND_TAGLINE=
# DIS_BRAND_FOOTER=
# DIS_PROFILE=full                      # full | reporting (reporting-only deployment)
# DIS_REPORT_TZ=Asia/Riyadh             # report stamps, file-name dates, send hour
# DIS_REPORT_SEND_HOUR=                 # e.g. 6; blank = send whenever due
# DIS_REPORT_CALENDAR_MONTHS=False      # True = monthly on the 1st, not every 30 days
# DIS_EMAIL_SUBJECT_PREFIX=[DSE Report]
# DIS_ALERT_SUBJECT_PREFIX=[DSE Alert]
# DIS_EXPORT_MAX_ROWS=100000            # larger exports are refused (HTTP 413)
# DIS_EXPORT_PDF_MAX_ROWS=2000

# ---- Query execution safety ----
DSE_QUERY_MAX_ROWS=5000
DSE_QUERY_TIMEOUT_SECONDS=30
DSE_CONNECTION_TEST_TIMEOUT=10

# ---- AI assistant (Claude API) ----
# Get a key at https://console.anthropic.com/ — leave blank to disable AI features.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ---- Bootstrap admin (used by: python manage.py bootstrap) ----
DSE_ADMIN_USERNAME=admin
DSE_ADMIN_PASSWORD=admin12345
DSE_ADMIN_EMAIL=admin@dse.local

# ---- Forecasting source DB (LIMS — external SQL Server, read-only) ----
# Used by the `forecasting` app (instrument downtime / sample volume /
# inventory consumption). Requires the Microsoft ODBC Driver 18 for SQL Server.
DB_ENGINE=mssql
DB_NAME=SMJMUN_DEV
DB_USER=SA
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
# Optional inventory DB overrides (default to the values above):
# DB_HOST_INVENTORY=127.0.0.1
# DB_INVENTORY_NAME=SMJMUN_DEV
# Back-fill dbo.SAMPLE.Labs on each request (off by default; not needed for forecasts):
FORECAST_SYNC_LABS_COLUMN=False
FORECAST_DB_TIMEOUT=15
